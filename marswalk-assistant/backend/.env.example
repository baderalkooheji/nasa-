# Marswalk AI Assistant - configuration. Copy to .env and change what you need (all values below are the defaults).

# Server (8000 = Scientific Intelligence Engine, 8085 = Marswalk app, so the assistant uses 8095)
HOST=127.0.0.1
PORT=8095
DEBUG=false

# Local LLM (Ollama). qwen3:1.7b runs on a laptop CPU; qwen3:4b chooses tools better but is ~2.5x slower.
OLLAMA_HOST=http://127.0.0.1:11434
DEFAULT_MODEL=qwen3:1.7b
MODEL_TIMEOUT=180
NUM_CTX=8192
THINK=false
KEEP_ALIVE=30m
MAX_TOOL_ROUNDS=3

# Marswalk backend: real DEM terrain, routes, EVA budget, stops, mission log
MARSWALK_API_URL=http://127.0.0.1:8085

# Knowledge base: every PDF/TXT/MD/JSON file in this folder is indexed at startup (default: backend/data/documents)
# DOCUMENTS_DIR=
CHUNK_SIZE=900
CHUNK_OVERLAP=120

MAX_HISTORY_MESSAGES=8
TOOL_TIMEOUT=120
