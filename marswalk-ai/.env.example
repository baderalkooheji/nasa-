# Marswalk AI configuration. Copy to .env (same folder) and fill in what you have.
# Nothing here is required: with no keys the assistant runs in offline rule-based mode.

# ---------------- LLM provider -----------------------------------------------------
# auto | offline | gemini | anthropic | openai   (auto = first provider with a key: gemini, anthropic, openai)
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Any OpenAI-compatible endpoint (OpenAI, Ollama http://localhost:11434/v1, vLLM, LM Studio, OpenRouter ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# native = function calling; json = structured JSON protocol for models without tool calling
OPENAI_TOOL_MODE=native
LLM_TIMEOUT_S=45
MAX_TOOL_ROUNDS=6

# ---------------- Integrations -----------------------------------------------------
# Scientific Intelligence Engine (python -m uvicorn app.main:app --port 8000 in its repo)
SCIENCE_ENGINE_URL=
# Original Marswalk backend, once it exists. POST endpoints must be listed explicitly:
# stops,elevation,route_auto,route_analyze,eva,spaceweather,meda,records
MARSWALK_API_URL=
MARSWALK_ENABLED_ENDPOINTS=
# Folder of Markdown documents with front matter (e.g. the engine's data/documents)
KNOWLEDGE_DIR=

# ---------------- Terrain ----------------------------------------------------------
# Defaults point at ../data/raw/... when marswalk-ai/ sits inside the Marswalk checkout.
CTX_DEM_PATH=
HIRISE_DTM_PATH=
# If no DEM is available, use a clearly labelled SIMULATED surface (set false to disable terrain instead)
ALLOW_SYNTHETIC_TERRAIN=true

# ---------------- Project-defined planning parameters (not NASA standards) ---------
MAX_SLOPE_DEG=15
CAUTION_SLOPE_DEG=10
K_SUIT=0.60
STOP_MINUTES=30
SUIT_BUDGET_HOURS=4
RESERVE_PERCENT=20
RAD_REFERENCE_MGY_DAY=0.21

# ---------------- Server -----------------------------------------------------------
SESSION_DB=
CORS_ORIGINS=*
